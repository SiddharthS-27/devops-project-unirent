# Staging (Parv). Copy to infra/env/.env on the staging host and fill in the secrets.
# CI's deploy job sets API_IMAGE and WORKERS_IMAGE to the commit being deployed.
PROFILE=staging
ENVIRONMENT=staging
LOG_LEVEL=INFO
API_RELOAD=
API_IMAGE=ghcr.io/sasvat007/unirent-api:latest
WORKERS_IMAGE=ghcr.io/sasvat007/unirent-workers:latest

# Public addresses (Caddy gets certificates for both)
STAGING_DOMAIN=api.unirent.example.in
GRAFANA_DOMAIN=grafana.unirent.example.in
STORAGE_PUBLIC_URL=https://files.unirent.example.in
# The api only trusts forwarded headers because it is reachable through Caddy alone.
FORWARDED_ALLOW_IPS=*
API_BIND=127.0.0.1

POSTGRES_DB=unirent
POSTGRES_USER=unirent
POSTGRES_PASSWORD=
APP_DB_USER=unirent_app
APP_DB_PASSWORD=
WORKERS_DB_USER=unirent_workers
WORKERS_DB_PASSWORD=
MINIO_ROOT_USER=unirent
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=photos
SERVICE_TOKEN=
JWT_SECRET=

# Real sign-in on staging; the mock modes are refused here anyway.
MS_AUTH_MODE=microsoft
MS_CLIENT_ID=
MS_TENANT_ID=
MS_ALLOWED_DOMAIN=
PHONE_AUTH_MODE=firebase
FIREBASE_PROJECT_ID=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Razorpay test mode. The webhook URL is https://$STAGING_DOMAIN/api/v1/payments/webhooks/razorpay
RAZORPAY_API_BASE=https://api.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Pushes through FCM: put the service account key at infra/env/fcm.json
PUSH_MODE=fcm
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
SIGNIN_LIMIT_PER_MINUTE=10
FCM_CREDENTIALS=./env/fcm.json
