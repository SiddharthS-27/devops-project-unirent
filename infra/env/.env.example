# Copy to infra/env/.env (make up does this on first run). Never commit .env.
# Each section names the variable's owner. Add new variables here in the same PR that uses them.

# PostgreSQL (Parv)
POSTGRES_DB=unirent
POSTGRES_USER=unirent
POSTGRES_PASSWORD=unirent-dev-password
# Restricted users the api and workers connect as (created on first start)
APP_DB_USER=unirent_app
APP_DB_PASSWORD=unirent-app-dev-password
WORKERS_DB_USER=unirent_workers
WORKERS_DB_PASSWORD=unirent-workers-dev-password

# MinIO photo storage (Parv)
MINIO_ROOT_USER=unirent
MINIO_ROOT_PASSWORD=unirent-dev-password
MINIO_BUCKET=photos

# Host ports (Parv). Change these if something on your laptop already uses them.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
KAFKA_UI_PORT=8080

# Profile make up starts: dev, test or staging (Parv)
PROFILE=dev

# API (Rammohan). The workers send SERVICE_TOKEN on /internal routes.
ENVIRONMENT=dev
SERVICE_TOKEN=dev-service-token
LOG_LEVEL=INFO
API_RELOAD=--reload
# Images; staging sets these to the registry tags CI pushed.
API_IMAGE=unirent-api:dev
WORKERS_IMAGE=unirent-workers:dev

# Sign-in (Siddharth). mock modes need no Microsoft or Firebase project and are
# refused in staging. JWT_SECRET must be long and random outside dev.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
MS_AUTH_MODE=mock
MS_CLIENT_ID=mock-client
MS_TENANT_ID=mock-tenant
MS_ALLOWED_DOMAIN=college.edu
PHONE_AUTH_MODE=mock
FIREBASE_PROJECT_ID=unirent-dev
ADMIN_EMAIL=admin@unirent.in
ADMIN_PASSWORD=change-me-admin-password

# Razorpay (Siddharth). Leave the base URL on the simulator unless you have test keys.
RAZORPAY_API_BASE=http://razorpay-sim:8090
RAZORPAY_KEY_ID=rzp_test_sim
RAZORPAY_KEY_SECRET=sim-key-secret
RAZORPAY_WEBHOOK_SECRET=sim-webhook-secret

# Tests (Parv). The test profile raises the sign-in limit because every test
# student signs in from the one test-runner container.
TESTS_IMAGE=unirent-tests:dev
RAZORPAY_SIM_PORT=8090
SIGNIN_LIMIT_PER_MINUTE=10

# Photos (Parv). Phones upload here directly: use your laptop's LAN address when
# testing on a real phone, e.g. http://192.168.1.20:9000
STORAGE_PUBLIC_URL=http://localhost:9000

# Monitoring (Sasvat). Grafana at http://localhost:3000.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Workers (Sasvat). PUSH_MODE=fcm needs infra/env/fcm.json (a service account key).
PUSH_MODE=log
