{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unirent.in/contracts/events/ListingPublished.schema.json",
  "title": "ListingPublished",
  "description": "A listing went live. The saved-search matcher pushes to students whose saved searches match.",
  "x-topic": "listings.events",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "version",
    "occurred_at",
    "producer",
    "aggregate_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Consumers skip ids they have processed"
    },
    "type": {
      "const": "ListingPublished"
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "backend"
    },
    "aggregate_id": {
      "type": "string",
      "description": "Kafka message key; keeps one aggregate's events in order"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "listing_id",
        "owner_id",
        "title",
        "kind",
        "category",
        "price_paise"
      ],
      "properties": {
        "listing_id": {
          "type": "string",
          "format": "uuid"
        },
        "owner_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "rent",
            "sale"
          ]
        },
        "category": {
          "type": "string"
        },
        "price_paise": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
