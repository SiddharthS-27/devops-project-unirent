{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unirent.in/contracts/events/ReconciliationMismatchFound.schema.json",
  "title": "ReconciliationMismatchFound",
  "description": "Reconciliation found the ledger and Razorpay disagreeing. Raises an alert; no push.",
  "x-topic": "payments.events",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "type",
    "version",
    "occurred_at",
    "producer",
    "aggregate_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Consumers skip ids they have processed"
    },
    "type": {
      "const": "ReconciliationMismatchFound"
    },
    "version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "payments"
    },
    "aggregate_id": {
      "type": "string",
      "description": "Kafka message key; keeps one aggregate's events in order"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "run_id",
        "kind",
        "reference"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "enum": [
            "missing_in_razorpay",
            "missing_in_ledger",
            "amount_differs",
            "status_differs",
            "transfer_missing"
          ]
        },
        "reference": {
          "type": "string"
        },
        "ledger_amount_paise": {
          "type": [
            "integer",
            "null"
          ]
        },
        "razorpay_amount_paise": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  }
}
